{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy preferredLanguage baseLocale --emit-ts-declarations && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"contract": "node scripts/contract-types.js"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@inlang/paraglide-js": "2.25.4",
		"@inlang/plugin-m-function-matcher": "2.2.16",
		"@inlang/plugin-message-format": "4.4.4",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.0.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@testing-library/svelte": "5.4.2",
		"@types/node": "22.20.5",
		"eslint": "10.12.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.13.0",
		"jsdom": "29.1.1",
		"json-schema-to-typescript": "16.0.0",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.0",
		"vite": "8.3.2",
		"vitest": "5.0.3"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=22.17.0 <23"
	}
}
