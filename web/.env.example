# Lists every variable web/src/env.ts reads. Copy this file to web/.env.
# Absolute URL of the games feed, e.g. https://api.example.com/feeds/games.json
GAMES_FEED_URL=
# Absolute URL of the standings feed, e.g. https://api.example.com/feeds/standings.json
STANDINGS_FEED_URL=
# Absolute URL of the search feed, e.g. https://api.example.com/feeds/search.json
SEARCH_FEED_URL=
# Absolute URL of the Cup feed, e.g. https://api.example.com/feeds/cup.json
CUP_FEED_URL=
# Absolute URL of a Cup matchup feed, with {id} where the slot id goes
CUP_MATCHUP_FEED_URL=
# Absolute URL of the playoffs feed, e.g. https://api.example.com/feeds/playoffs.json
PLAYOFFS_FEED_URL=
# Absolute URL of the playoffs finals feed, e.g. https://api.example.com/feeds/playoffs/finals.json
PLAYOFFS_FINALS_FEED_URL=
# Absolute URL of the All-Star feed, e.g. https://api.example.com/feeds/all-star.json
ALL_STAR_FEED_URL=
# Absolute URL of the home feed, e.g. https://api.example.com/feeds/home.json
HOME_FEED_URL=
# Absolute URL of the power ranking feed, e.g. https://api.example.com/feeds/power-ranking.json
POWER_RANKING_FEED_URL=
# Absolute URL of a game's detail feed, with {id} where the game id goes
GAME_DETAIL_FEED_URL=
# Absolute URL of a team's feed, with {code} where the lowercase team code goes
TEAM_FEED_URL=
# Absolute URL of a player's feed, with {id} where the player id goes
PLAYER_FEED_URL=
# Absolute URL of a season's calendar feed, with {season} where the season's end year or current goes
CALENDAR_FEED_URL=
# Absolute URL of a day's feed, with {date} where the YYYY-MM-DD date goes
DAY_FEED_URL=
# Absolute URL of the standings feed of a past season, with {season} where the season's end year goes
SEASON_STANDINGS_FEED_URL=
# Absolute URL of a team's feed in a past season, with {season} where the end year goes and {code} where the lowercase team code goes
SEASON_TEAM_FEED_URL=
# Absolute URL of a player's feed in a past season, with {season} where the end year goes and {id} where the player id goes
SEASON_PLAYER_FEED_URL=
# Absolute URL of the Cup feed of a past season, with {season} where the season's end year goes
SEASON_CUP_FEED_URL=
# Absolute URL of a Cup matchup feed in a past season, with {season} where the end year goes and {slot} where the bracket slot id goes
SEASON_CUP_MATCHUP_FEED_URL=
# Absolute URL of the playoffs feed of a past season, with {season} where the season's end year goes
SEASON_PLAYOFFS_FEED_URL=
# Absolute URL of the playoffs finals feed of a past season, with {season} where the season's end year goes
SEASON_PLAYOFFS_FINALS_FEED_URL=
# Absolute URL of the All-Star feed of a past season, with {season} where the season's end year goes
SEASON_ALL_STAR_FEED_URL=
# Name of the video platform shown next to the highlights
VIDEO_PLATFORM_NAME=
