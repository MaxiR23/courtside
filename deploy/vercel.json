{
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "${BACKEND_URL}/$1",
      "env": ["BACKEND_URL"],
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-origin-secret" },
          "args": "$ORIGIN_SECRET",
          "env": ["ORIGIN_SECRET"]
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/standings", "destination": "/200.html" },
    { "source": "/cup", "destination": "/200.html" },
    { "source": "/playoffs", "destination": "/200.html" },
    { "source": "/playoffs/series", "destination": "/200.html" },
    { "source": "/all-star", "destination": "/200.html" },
    { "source": "/all-star/previous", "destination": "/200.html" },
    { "source": "/day/:path*", "destination": "/200.html" },
    { "source": "/game/:path*", "destination": "/200.html" },
    { "source": "/player/:path*", "destination": "/200.html" },
    { "source": "/team/:path*", "destination": "/200.html" }
  ]
}
