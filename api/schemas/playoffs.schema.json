{
  "$defs": {
    "Award": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/AwardCode"
        },
        "team": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "winners": {
          "items": {
            "$ref": "#/$defs/AwardWinner"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "code",
        "team",
        "winners"
      ],
      "title": "Award",
      "type": "object"
    },
    "AwardCode": {
      "description": "The kind of a season award, shared by the playoffs and the player feeds.",
      "enum": [
        "mvp",
        "dpoy",
        "roy",
        "sixth_man",
        "mip",
        "cpoy",
        "finals_mvp",
        "east_finals_mvp",
        "west_finals_mvp",
        "all_star_mvp",
        "cup_mvp",
        "cup_all_tournament",
        "all_nba",
        "all_rookie",
        "all_defensive",
        "twyman_stokes"
      ],
      "title": "AwardCode",
      "type": "string"
    },
    "AwardWinner": {
      "additionalProperties": false,
      "properties": {
        "playerId": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "photoUrl": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "teamCode": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "seasonCode": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "accent": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "playerId",
        "name",
        "photoUrl",
        "teamCode",
        "seasonCode",
        "accent"
      ],
      "title": "AwardWinner",
      "type": "object"
    },
    "Champion": {
      "additionalProperties": false,
      "properties": {
        "team": {
          "$ref": "#/$defs/PlayoffTeam"
        },
        "wins": {
          "const": 4,
          "type": "integer"
        },
        "losses": {
          "maximum": 3,
          "minimum": 0,
          "type": "integer"
        },
        "firstDate": {
          "format": "date",
          "type": "string"
        },
        "lastDate": {
          "format": "date",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "pattern": "^\\d+-\\d+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "home": {
          "anyOf": [
            {
              "pattern": "^\\d+-\\d+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "road": {
          "anyOf": [
            {
              "pattern": "^\\d+-\\d+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "pointDifferential": {
          "$ref": "#/$defs/TotalDifferential"
        },
        "accent": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "team",
        "wins",
        "losses",
        "firstDate",
        "lastDate",
        "record",
        "home",
        "road",
        "pointDifferential",
        "accent"
      ],
      "title": "Champion",
      "type": "object"
    },
    "Clinch": {
      "enum": [
