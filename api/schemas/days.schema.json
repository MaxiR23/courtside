{
  "$defs": {
    "Conference": {
      "enum": [
        "east",
        "west"
      ],
      "title": "Conference",
      "type": "string"
    },
    "CupRound": {
      "enum": [
        "group",
        "quarterfinals",
        "semifinals",
        "championship"
      ],
      "title": "CupRound",
      "type": "string"
    },
    "GameAllStar": {
      "additionalProperties": false,
      "description": "The mark of an All-Star game: its round as the source writes it, and\nwhether it is the Championship.",
      "properties": {
        "roundLabel": {
          "minLength": 1,
          "type": "string"
        },
        "championship": {
          "type": "boolean"
        }
      },
      "required": [
        "roundLabel",
        "championship"
      ],
      "title": "GameAllStar",
      "type": "object"
    },
    "GameCup": {
      "additionalProperties": false,
      "description": "The mark of a Cup game: the round it belongs to.",
      "properties": {
        "stage": {
          "$ref": "#/$defs/CupRound"
        }
      },
      "required": [
        "stage"
      ],
      "title": "GameCup",
      "type": "object"
    },
    "GamePostseason": {
      "additionalProperties": false,
      "description": "The mark of a play-in or playoff game: its stage, place in the bracket and stakes.",
      "properties": {
        "stage": {
          "$ref": "#/$defs/PostseasonStage"
        },
        "round": {
          "anyOf": [
            {
              "maximum": 4,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "conference": {
          "anyOf": [
            {
              "$ref": "#/$defs/Conference"
            },
            {
              "type": "null"
            }
          ]
        },
        "number": {
          "anyOf": [
            {
              "maximum": 7,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "playIn": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlayInGameKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "stakes": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stakes"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "stage",
        "round",
        "conference",
        "number",
        "summary",
        "playIn",
        "stakes"
      ],
      "title": "GamePostseason",
      "type": "object"
    },
    "GameStatus": {
      "enum": [
        "scheduled",
        "live",
        "final",
        "delayed",
        "postponed",
        "canceled"
      ],
      "title": "GameStatus",
      "type": "string"
    },
    "GameTeam": {
      "additionalProperties": false,
      "description": "A side of a game: one of the 30 teams, or a guest team outside the league.\nA guest may have no city (an All-Star team); a league team has one.",
      "properties": {
        "code": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "city": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "guest": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "name",
        "city",
        "guest"
      ],
      "title": "GameTeam",
      "type": "object"
    },
    "GameTeamStats": {
      "additionalProperties": false,
      "properties": {
        "away": {
          "$ref": "#/$defs/TeamStats"
        },
        "home": {
          "$ref": "#/$defs/TeamStats"
        }
      },
      "required": [
        "away",
        "home"
      ],
      "title": "GameTeamStats",
      "type": "object"
    },
    "Highlight": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "channel": {
          "minLength": 1,
          "type": "string"
        },
        "thumbnailUrl": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "type": "string"
        },
        "embedUrl": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "title",
        "channel",
        "thumbnailUrl",
        "embedUrl"
      ],
      "title": "Highlight",
      "type": "object"
    },
    "Leader": {
      "additionalProperties": false,
      "properties": {
        "playerId": {
          "minLength": 1,
          "type": "string"
        },
        "displayName": {
          "minLength": 1,
          "type": "string"
        },
        "teamCode": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "photoUrl": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "points": {
          "minimum": 0,
          "type": "integer"
        },
        "rebounds": {
          "minimum": 0,
          "type": "integer"
        },
        "assists": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "playerId",
        "displayName",
        "teamCode",
        "photoUrl",
        "points",
        "rebounds",
        "assists"
      ],
      "title": "Leader",
      "type": "object"
    },
    "Leaders": {
      "additionalProperties": false,
      "properties": {
        "away": {
          "$ref": "#/$defs/Leader"
        },
        "home": {
          "$ref": "#/$defs/Leader"
        }
      },
      "required": [
        "away",
        "home"
      ],
      "title": "Leaders",
      "type": "object"
    },
    "LineScore": {
      "additionalProperties": false,
      "properties": {
        "away": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "minItems": 1,
          "type": "array"
        },
        "home": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "away",
        "home"
      ],
      "title": "LineScore",
      "type": "object"
    },
    "PastDay": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "format": "date",
          "type": "string"
        },
        "games": {
          "items": {
            "$ref": "#/$defs/PastGame"
          },
          "type": "array"
        }
      },
      "required": [
        "date",
        "games"
      ],
      "title": "PastDay",
      "type": "object"
    },
    "PastGame": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "away": {
          "$ref": "#/$defs/GameTeam"
        },
        "home": {
          "$ref": "#/$defs/GameTeam"
        },
        "status": {
          "$ref": "#/$defs/GameStatus"
        },
        "startTime": {
          "format": "date-time",
          "type": "string"
        },
        "venue": {
          "minLength": 1,
          "type": "string"
        },
        "stars": {
          "$ref": "#/$defs/Stars"
        },
        "highlights": {
          "items": {
            "$ref": "#/$defs/Highlight"
          },
          "type": "array"
        },
        "broadcast": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "period": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "clock": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lineScore": {
          "anyOf": [
            {
              "$ref": "#/$defs/LineScore"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "score": {
          "anyOf": [
            {
              "$ref": "#/$defs/Score"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "winner": {
          "anyOf": [
            {
              "$ref": "#/$defs/Side"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "leaders": {
          "anyOf": [
            {
              "$ref": "#/$defs/Leaders"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "teamStats": {
          "anyOf": [
            {
              "$ref": "#/$defs/GameTeamStats"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "statsAvailability": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatsAvailability"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "highlightsSearchUrl": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cup": {
          "anyOf": [
            {
              "$ref": "#/$defs/GameCup"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "postseason": {
          "anyOf": [
            {
              "$ref": "#/$defs/GamePostseason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "allStar": {
          "anyOf": [
            {
              "$ref": "#/$defs/GameAllStar"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "away",
        "home",
        "status",
        "startTime",
        "venue",
        "stars",
        "highlights",
        "broadcast",
        "period",
        "clock",
        "lineScore",
        "score",
        "winner",
        "leaders",
        "teamStats",
        "statsAvailability",
        "highlightsSearchUrl",
        "cup",
        "postseason",
        "allStar"
      ],
      "title": "PastGame",
      "type": "object"
    },
    "PlayInGameKind": {
      "enum": [
        "seven_eight",
        "nine_ten",
        "eighth_seed"
      ],
      "title": "PlayInGameKind",
      "type": "string"
    },
    "PostseasonStage": {
      "enum": [
        "playin",
        "playoffs",
        "finals"
      ],
      "title": "PostseasonStage",
      "type": "string"
    },
    "Score": {
      "additionalProperties": false,
      "properties": {
        "away": {
          "minimum": 0,
          "type": "integer"
        },
        "home": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "away",
        "home"
      ],
      "title": "Score",
      "type": "object"
    },
    "Side": {
      "enum": [
        "away",
        "home"
      ],
      "title": "Side",
      "type": "string"
    },
    "Stakes": {
      "enum": [
        "game_7",
        "elimination",
        "can_clinch",
        "clinched"
      ],
      "title": "Stakes",
      "type": "string"
    },
    "Star": {
      "additionalProperties": false,
      "properties": {
        "playerId": {
          "minLength": 1,
          "type": "string"
        },
        "firstName": {
          "minLength": 1,
          "type": "string"
        },
        "lastName": {
          "minLength": 1,
          "type": "string"
        },
        "teamCode": {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "photoUrl": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "type": "string"
        },
        "shortName": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "playerId",
        "firstName",
        "lastName",
        "teamCode",
        "photoUrl",
        "shortName"
      ],
      "title": "Star",
      "type": "object"
    },
    "Stars": {
      "additionalProperties": false,
      "properties": {
        "away": {
          "anyOf": [
            {
              "$ref": "#/$defs/Star"
            },
            {
              "type": "null"
            }
          ]
        },
        "home": {
          "anyOf": [
            {
              "$ref": "#/$defs/Star"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "away",
        "home"
      ],
      "title": "Stars",
      "type": "object"
    },
    "StatsAvailability": {
      "enum": [
        "available",
        "pending",
        "unavailable"
      ],
      "title": "StatsAvailability",
      "type": "string"
    },
    "TeamStats": {
      "additionalProperties": false,
      "properties": {
        "fieldGoalPct": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "threePointPct": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "rebounds": {
          "minimum": 0,
          "type": "integer"
        },
        "assists": {
          "minimum": 0,
          "type": "integer"
        },
        "turnovers": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "fieldGoalPct",
        "threePointPct",
        "rebounds",
        "assists",
        "turnovers"
      ],
      "title": "TeamStats",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "generatedAt": {
      "format": "date-time",
      "type": "string"
    },
    "season": {
      "minimum": 1994,
      "type": "integer"
    },
    "seasonLabel": {
      "pattern": "^\\d{4}-\\d{2}$",
      "type": "string"
    },
    "day": {
      "$ref": "#/$defs/PastDay"
    }
  },
  "required": [
    "generatedAt",
    "season",
    "seasonLabel",
    "day"
  ],
  "title": "DayFeed",
  "type": "object"
}
