{
  "$defs": {
    "NewsKind": {
      "enum": [
        "news",
        "recap"
      ],
      "title": "NewsKind",
      "type": "string"
    },
    "NewsLanguage": {
      "enum": [
        "en",
        "es"
      ],
      "title": "NewsLanguage",
      "type": "string"
    },
    "NewsNote": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9-]+$",
          "type": "string"
        },
        "language": {
          "$ref": "#/$defs/NewsLanguage"
        },
        "kind": {
          "$ref": "#/$defs/NewsKind"
        },
        "headline": {
          "minLength": 1,
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "published": {
          "format": "date-time",
          "type": "string"
        },
        "photo": {
          "anyOf": [
            {
              "$ref": "#/$defs/NewsPhoto"
            },
            {
              "type": "null"
            }
          ]
        },
        "teams": {
          "items": {
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          },
          "type": "array"
        },
        "players": {
          "items": {
            "$ref": "#/$defs/NewsPlayer"
          },
          "type": "array"
        },
        "gameId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "language",
        "kind",
        "headline",
        "description",
        "published",
        "photo",
        "teams",
        "players",
        "gameId"
      ],
      "title": "NewsNote",
      "type": "object"
    },
    "NewsPhoto": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "credit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "url",
        "width",
        "height",
        "credit"
      ],
      "title": "NewsPhoto",
      "type": "object"
    },
    "NewsPlayer": {
      "additionalProperties": false,
      "properties": {
        "playerId": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "playerId",
        "name"
      ],
      "title": "NewsPlayer",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "page": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "hasMore": {
      "type": "boolean"
    },
    "notes": {
      "items": {
        "$ref": "#/$defs/NewsNote"
      },
      "maxItems": 12,
      "type": "array"
    }
  },
  "required": [
    "page",
    "hasMore",
    "notes"
  ],
  "title": "NewsFeed",
  "type": "object"
}
