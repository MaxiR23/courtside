# Lists every variable Settings reads. Copy this file to api/.env.
ENVIRONMENT=development
# Template with {date}, the US Eastern date as YYYYMMDD
SCOREBOARD_URL=
# Template with {game_id}, the provider's game id
GAME_DETAIL_URL=
PLAYER_PHOTO_URL=
# Template with {team}, the provider's team code
TEAM_ROSTER_URL=
# Template with {team}, the provider's team id from the roster, and {season}
TEAM_AVERAGES_URL=
# Template with {player_id}, the provider's player id, and {season}
PLAYER_AVERAGES_URL=
# Standings of both conferences
STANDINGS_URL=
# Template with {team}, the provider's team code; the adapter adds the season and the season type to its query
TEAM_SCHEDULE_URL=
# Injuries of every team in the league
LEAGUE_INJURIES_URL=
# Template with {player_id}, the provider's player id: bio with the season summary
PLAYER_BIO_URL=
# Template with {player_id}: the player's draft
PLAYER_DRAFT_URL=
# Template with {player_id}: the player's overview with the awards
PLAYER_OVERVIEW_URL=
# Template with {player_id}: the player's game log of the current season
PLAYER_GAMELOG_URL=
# Template with {player_id}: the player's season stats; the adapter adds the playoffs season type to its query
PLAYER_STATS_URL=
# Template with {team}, the provider's team code: colors, arena and images
TEAM_INFO_URL=
# Standings by division of the regular season, requested as is: its query must select the regular season
DIVISION_STANDINGS_URL=
# Listing of the official channel's uploads, without the key; the adapter adds the page size and the page token
HIGHLIGHTS_SOURCE_URL=
# Key of the video source. Never commit a value
HIGHLIGHTS_SOURCE_KEY=
# Template with {video_id}, the channel's video id
VIDEO_EMBED_URL=
# Template with {query}, the search words, already URL-encoded
HIGHLIGHTS_SEARCH_URL=
# US Eastern time of the daily schedule fetch, HH:MM
DAILY_FETCH_TIME=06:00
DATA_DIR=data
# JSON list of the front end origins allowed by CORS, e.g. ["https://example.com"]
CORS_ORIGINS=[]
