# Lists every variable Settings reads. Copy this file to api/.env.
ENVIRONMENT=development
SCOREBOARD_URL=
GAME_DETAIL_URL=
PLAYER_PHOTO_URL=
# US Eastern time of the daily schedule fetch, HH:MM
DAILY_FETCH_TIME=06:00
DATA_DIR=data
# JSON list of the front end origins allowed by CORS, e.g. ["https://example.com"]
CORS_ORIGINS=[]
