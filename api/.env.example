# Lists every variable Settings reads. Copy this file to api/.env.
ENVIRONMENT=development
# Template with {date}, the US Eastern date as YYYYMMDD
SCOREBOARD_URL=
# Template with {game_id}, the provider's game id
GAME_DETAIL_URL=
PLAYER_PHOTO_URL=
# Template with {team}, the provider's team code
TEAM_ROSTER_URL=
# Template with {team}, the provider's team id from the roster, and {season}
TEAM_AVERAGES_URL=
# Template with {player_id}, the provider's player id, and {season}
PLAYER_AVERAGES_URL=
# Standings of both conferences
STANDINGS_URL=
# Template with {team}, the provider's team code; the adapter adds the season and the season type to its query
TEAM_SCHEDULE_URL=
# Injuries of every team in the league
LEAGUE_INJURIES_URL=
# Template with {player_id}, the provider's player id: bio with the season summary
PLAYER_BIO_URL=
# Template with {player_id}: the player's draft
PLAYER_DRAFT_URL=
# Template with {player_id}: the player's overview with the awards
PLAYER_OVERVIEW_URL=
# Template with {player_id}: the player's game log of the current season
PLAYER_GAMELOG_URL=
# Template with {player_id}: the player's season stats; the adapter adds the playoffs season type to its query
PLAYER_STATS_URL=
# Template with {team}, the provider's team code: colors, arena and images
TEAM_INFO_URL=
# Standings by division, requested as is: its query must select the regular season; when the response is not of the regular season, the adapter adds the season to its query
DIVISION_STANDINGS_URL=
# Template with {season}, the end year of the season, and {group}, the provider's group id: the teams collection of one Cup group
CUP_GROUP_URL=
# Template with {season} and {group}: the Cup table (the standings item named "inseason") of one Cup group or Cup conference
CUP_GROUP_STANDINGS_URL=
# Template with {season}, the end year of the season, and {team_id}, the provider's team id: the current depth chart of one team
DEPTH_CHART_URL=
# Template with {season}, the end year of the season, and {team_id}, the provider's team id: the team object of one season, with its abbreviation, display name, name, location and active state
SEASON_TEAM_URL=
# Template with {season} and {team_id}: the roster collection of one team in one season
SEASON_ROSTER_URL=
# Template with {season}, the end year of the season, and {type}, the season type (2 regular season, 5 play-in, 3 postseason): the start and end of that season type
SEASON_TYPE_URL=
# Template with {season}: the postseason leaders by category
POSTSEASON_LEADERS_URL=
# Template with {season} and {team_id}, the provider's team id: the postseason record of one team (overall, home and road)
TEAM_POSTSEASON_RECORD_URL=
# Template with {season} and {team_id}: the postseason statistics of one team
TEAM_POSTSEASON_STATS_URL=
# Template with {season}: the awards of the season with their winners
SEASON_AWARDS_URL=
# Listing of the official channel's uploads, without the key; the adapter adds the page size and the page token
HIGHLIGHTS_SOURCE_URL=
# Key of the video source. Never commit a value
HIGHLIGHTS_SOURCE_KEY=
# Template with {video_id}, the channel's video id
VIDEO_EMBED_URL=
# Template with {query}, the search words, already URL-encoded
HIGHLIGHTS_SEARCH_URL=
# Channel-scoped search endpoint of the video API, without the key; the adapter adds the query and the result count
HIGHLIGHTS_SEARCH_API_URL=
# Searches the on-demand highlights search sends per US Eastern day, a positive integer
HIGHLIGHTS_SEARCH_DAILY_CAP=80
# US Eastern time of the daily schedule fetch, HH:MM
DAILY_FETCH_TIME=06:00
DATA_DIR=data
# JSON list of the front end origins allowed by CORS, e.g. ["https://example.com"]
CORS_ORIGINS=[]
