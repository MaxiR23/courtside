# Lists every variable compose.yaml reads. Copy this file to .env at the repository root.
# Domain the API is served on: ":80" in the production setup (plain HTTP behind the Vercel site),
# or a domain pointing to this machine for the certificate setup, e.g. api.example.com
API_DOMAIN=
# Secret Vercel sends in the X-Origin-Secret header; requests without it get 403.
# Generate it with: openssl rand -hex 32
# It must equal the Vercel project variable of the same name.
ORIGIN_SECRET=
