# Lists every variable scripts/deploy.sh reads. Copy this file to .env.deploy at the repository root.
# Plain KEY=value lines, without quotes.
# Host alias of the machine in ~/.ssh/config, e.g. courtside-vm
DEPLOY_SSH_HOST=
# Address of the Vercel site, https and no trailing slash, e.g. https://www.example.com
DEPLOY_SITE_URL=
# Absolute path of a folder dedicated to the deploy, linked to the Vercel project with vercel link.
# Not /, not the home folder, not inside the repository and not a folder that contains it.
# Its contents are replaced on every deploy, except .vercel.
DEPLOY_VERCEL_DIR=
# The projectId in .vercel/project.json of DEPLOY_VERCEL_DIR after vercel link.
# The web deploy stops when it is missing or differs from that file.
DEPLOY_VERCEL_PROJECT_ID=
